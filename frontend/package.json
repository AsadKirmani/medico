  "build": {
    "appId": "io.medico.app",
    "icon": "/src/assets/img/logo.png",
    "extends": null,
    "files": [
      "build/**/*",
      "public/electron.js"
    ]
  },
  "resolutions": {
    "react-error-overlay": "6.0.9"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
